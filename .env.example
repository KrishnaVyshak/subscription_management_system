# Copy to .env (git-ignored) and fill in. Both backend and frontend read this one file.

# --- Server ---
NODE_ENV=development
PORT=4000
TZ=Asia/Kolkata
APP_URL=http://localhost:5173

# Supabase dashboard -> Project Settings -> Database -> Connection string
# Use the direct connection or the session pooler (port 5432) for a long-running server.
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# Supabase dashboard -> Project Settings -> API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# SMTP: Mailtrap Email Sending -> Sending Domains -> your domain -> SMTP/API Settings (Transactional stream).
# SMTP_FROM must use an address on your verified sending domain.
SMTP_HOST=live.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=api
SMTP_PASS=
SMTP_FROM="Brightloop Billing <billing@yourdomain.com>"
# Optional; defaults to SMTP_FROM. Without full SMTP settings emails are logged, not sent.
MAIL_FROM=

# --- Admin account (npm run create-admin; idempotent) ---
ADMIN_EMAIL=admin@brightloop.test
ADMIN_PASSWORD=Admin@12345

# --- Behaviour ---
# true lets POST /api/billing/run and /api/jobs/:name/run use a future asOfDate (demos).
DEMO_MODE=false
# Daily jobs at 00:05 Asia/Kolkata (never in tests).
JOBS_ENABLED=true
# Optional throwaway database for integration tests (it is wiped). Unset = embedded Postgres.
TEST_DATABASE_URL=

# --- Frontend (only VITE_* vars are exposed to the browser) ---
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=/api
