# Copy to .env (git-ignored) and fill in. Both backend and frontend read this one file.

# --- Server ---
NODE_ENV=development
PORT=4000
TZ=Asia/Kolkata
APP_URL=http://localhost:5173

# Supabase dashboard -> Project Settings -> Database -> Connection string
# Use the direct connection or the session pooler (port 5432) for a long-running server.
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# Supabase dashboard -> Project Settings -> API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# SMTP (Mailtrap during development)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Brightloop Billing <billing@brightloop.test>"

# --- Frontend (only VITE_* vars are exposed to the browser) ---
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=/api
